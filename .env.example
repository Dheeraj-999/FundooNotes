# ==============================================================================
# FundooNotes Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values appropriately for your environment.
# NEVER commit sensitive credentials or live production tokens to version control.

# Server Configuration
SERVER_PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/fundoo_notes?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# JWT Authentication Configuration
# Base64-encoded secret key of at least 256 bits (32 bytes) for HMAC-SHA256 signature
JWT_SECRET=dGVzdC1zZWNyZXQta2V5LWZvci1mdW5kb28tbm90ZXMtZGVmYXVsdC1zZWNyZXQtMDAwMDAwMDA=
APP_JWT_EXPIRATION_MS=86400000

# Apache ActiveMQ (JMS) Configuration
ACTIVEMQ_BROKER_URL=tcp://localhost:61616
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin
APP_JMS_USER_REGISTRATION_QUEUE=user.registration.queue

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
APP_RABBITMQ_REMINDER_QUEUE=fundoo.reminder.queue
APP_RABBITMQ_REMINDER_EXCHANGE=fundoo.reminder.exchange
APP_RABBITMQ_REMINDER_ROUTING_KEY=reminder.created

# Redis Configuration (OTP Caching & Blacklisting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=60000
APP_REDIS_OTP_EXPIRATION=300
APP_REDIS_TOKEN_EXPIRATION=86400
